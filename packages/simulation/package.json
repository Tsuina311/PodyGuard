{
  "name": "@podyguard/simulation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:heavy": "SIMULATION_PROPERTY_RUNS=100000 vitest run src/strategy.property.test.ts src/matcher-baseline.test.ts",
    "run": "tsx src/cli.ts run",
    "benchmark": "tsx src/cli.ts benchmark",
    "sweep": "tsx src/cli.ts sweep",
    "sweep-opportunity": "tsx src/cli.ts sweep-opportunity",
    "sweep-scarcity": "tsx src/cli.ts sweep-scarcity",
    "sweep-seat-loss": "tsx src/cli.ts sweep-seat-loss",
    "sweep-weighted": "tsx src/cli.ts sweep-weighted",
    "sweep-pairwise": "tsx src/cli.ts sweep-pairwise",
    "sweep-wait-cause": "tsx src/cli.ts sweep-wait-cause",
    "compare": "tsx src/cli.ts compare",
    "build": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@podyguard/matching": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "fast-check": "^4.1.1",
    "tsx": "^4.23.12",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
