# Remote managed PostgreSQL (development).
# Copy to .env and fill in. Never commit .env.
#
# Use a DIFFERENT database (or project) for production.
# Do not use local PostgreSQL or Docker for this repository.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# If CONNECT_TIMEOUT hits port 5432, keep this URL (the app uses Neon WebSockets
# on 443). Prefer the Neon pooled connection string from the dashboard.
HOST=0.0.0.0
PORT=3001
NODE_ENV=development

# Event-scoped host and guest sessions (QR → display name → token).
# Required in production. Generate once and keep the value stable across deploys.
PARTICIPANT_SESSION_SECRET=generate-a-long-random-string

# In-app feedback. Use a fine-grained token with Issues: Read and write access
# to one private repository. Never expose either value to Vite.
GITHUB_FEEDBACK_TOKEN=github_pat_replace_me
GITHUB_FEEDBACK_REPO=OWNER/PRIVATE_REPOSITORY
