# Remote managed PostgreSQL (development).
# Copy to .env and fill in. Never commit .env.
#
# Use a DIFFERENT database (or project) for production.
# Do not use local PostgreSQL or Docker for this repository.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
HOST=0.0.0.0
PORT=3001
NODE_ENV=development

# Event-scoped guest sessions (QR → display name → token). Not Neon Auth.
# Required when issuing participant tokens. Leave unset until join exists.
# PARTICIPANT_SESSION_SECRET=generate-a-long-random-string
